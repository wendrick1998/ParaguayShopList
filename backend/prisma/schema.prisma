// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senha     String
  papel     String   @default("vendedor") // vendedor, gerente, admin
  lojaId    Int
  loja      Loja     @relation(fields: [lojaId], references: [id])
  vendas    Venda[]
  caixas    Caixa[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("usuarios")
}

model Loja {
  id                     Int                     @id @default(autoincrement())
  nome                   String
  cnpj                   String?                 @unique
  telefone               String?
  endereco               String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  usuarios               Usuario[]
  produtos               Produto[]
  estoques               Estoque[]
  vendas                 Venda[]
  movimentacoesEstoque   MovimentacaoEstoque[]
  caixas                 Caixa[]

  @@map("lojas")
}

model Produto {
  id            Int           @id @default(autoincrement())
  nome          String
  descricao     String?
  preco         Float
  codigoBarras  String?
  lojaId        Int
  loja          Loja          @relation(fields: [lojaId], references: [id])
  estoques      Estoque[]
  itensVenda    ItemVenda[]
  movimentacoes MovimentacaoEstoque[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("produtos")
}

model Estoque {
  id               Int      @id @default(autoincrement())
  produtoId        Int
  produto          Produto  @relation(fields: [produtoId], references: [id])
  lojaId           Int
  loja             Loja     @relation(fields: [lojaId], references: [id])
  quantidade       Int      @default(0)
  quantidadeMinima Int      @default(5)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([produtoId, lojaId])
  @@map("estoques")
}

model Venda {
  id              Int         @id @default(autoincrement())
  numero          String      @unique
  usuarioId       Int
  usuario         Usuario     @relation(fields: [usuarioId], references: [id])
  lojaId          Int
  loja            Loja        @relation(fields: [lojaId], references: [id])
  total           Float
  desconto        Float       @default(0)
  formaPagamento  String      // dinheiro, credito, debito, pix
  status          String      @default("concluida") // concluida, cancelada
  observacoes     String?
  itens           ItemVenda[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@map("vendas")
}

model ItemVenda {
  id         Int      @id @default(autoincrement())
  vendaId    Int
  venda      Venda    @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  produtoId  Int
  produto    Produto  @relation(fields: [produtoId], references: [id])
  quantidade Int
  precoUnit  Float
  subtotal   Float
  createdAt  DateTime @default(now())

  @@map("itens_venda")
}

model MovimentacaoEstoque {
  id          Int      @id @default(autoincrement())
  produtoId   Int
  produto     Produto  @relation(fields: [produtoId], references: [id])
  lojaId      Int
  loja        Loja     @relation(fields: [lojaId], references: [id])
  tipo        String   // entrada, saida, ajuste
  quantidade  Int
  motivo      String?
  observacoes String?
  createdAt   DateTime @default(now())

  @@map("movimentacoes_estoque")
}

model Caixa {
  id              Int      @id @default(autoincrement())
  lojaId          Int
  loja            Loja     @relation(fields: [lojaId], references: [id])
  usuarioId       Int
  usuario         Usuario  @relation(fields: [usuarioId], references: [id])
  dataAbertura    DateTime @default(now())
  dataFechamento  DateTime?
  saldoInicial    Float
  saldoFinal      Float?
  totalVendas     Float    @default(0)
  status          String   @default("aberto") // aberto, fechado
  observacoes     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("caixas")
}
