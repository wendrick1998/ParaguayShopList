# ============================================
# AUTOMATION INFRASTRUCTURE - ENV VARIABLES
# Curso Importação Paraguai - R$ 1M Launch
# ============================================

# DATABASE
DATABASE_URL=postgresql://user:password@localhost:5432/paraguay_course
NODE_ENV=development

# SERVER
PORT=3000
SESSION_SECRET=change-this-to-random-secret-in-production

# ============================================
# PAYMENT GATEWAYS
# ============================================

# Hotmart
HOTMART_SECRET=your_hotmart_webhook_secret
HOTMART_API_TOKEN=your_hotmart_api_token

# Kiwify
KIWIFY_API_KEY=your_kiwify_api_key
KIWIFY_WEBHOOK_SECRET=your_kiwify_webhook_secret

# ============================================
# TRACKING & ANALYTICS
# ============================================

# Facebook Pixel & Conversions API
FACEBOOK_PIXEL_ID=123456789012345
FACEBOOK_ACCESS_TOKEN=your_facebook_conversion_api_token

# Google Analytics 4
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
GOOGLE_ANALYTICS_SECRET=your_measurement_protocol_secret

# Google Tag Manager (Optional)
GTM_ID=GTM-XXXXXXX

# ============================================
# EMAIL MARKETING
# ============================================

# SendGrid
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=suporte@paraguayimport.com.br
SENDGRID_FROM_NAME=Equipe Paraguay Import

# Mailchimp (Alternative)
MAILCHIMP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxx-us1
MAILCHIMP_LIST_ID=your_list_id

# ============================================
# NOTIFICATIONS & ALERTS
# ============================================

# Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXX
SLACK_CRITICAL_CHANNEL=#alerts-critical
SLACK_SUPPORT_CHANNEL=#support-tickets

# Discord
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Telegram (Optional)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=-1001234567890

# ============================================
# THIRD-PARTY SERVICES
# ============================================

# WhatsApp Business API (Evolution API)
WHATSAPP_API_URL=https://evolution.yourdomain.com
WHATSAPP_API_KEY=your_evolution_api_key
WHATSAPP_INSTANCE_NAME=paraguay_course

# SMS (Twilio)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+5511999999999

# ============================================
# STORAGE & CDN
# ============================================

# AWS S3 (Videos & Materials)
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_REGION=us-east-1
AWS_S3_BUCKET=paraguay-course-content

# Cloudflare (Optional CDN)
CLOUDFLARE_ZONE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLOUDFLARE_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# VIDEO HOSTING
# ============================================

# Vimeo (Recommended)
VIMEO_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VIMEO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VIMEO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Bunny.net (Alternative)
BUNNY_STREAM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BUNNY_STREAM_LIBRARY_ID=12345

# ============================================
# COMMUNITY PLATFORMS
# ============================================

# Discord Bot
DISCORD_BOT_TOKEN=MTxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.xxxxxx.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DISCORD_SERVER_ID=000000000000000000
DISCORD_WELCOME_CHANNEL=000000000000000000

# ============================================
# MONITORING & ANALYTICS
# ============================================

# Datadog
DATADOG_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DATADOG_APP_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sentry (Error Tracking)
SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@o000000.ingest.sentry.io/0000000

# New Relic (Optional)
NEW_RELIC_LICENSE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# FEATURE FLAGS
# ============================================

# Enable/Disable Features
ENABLE_CHATBOT=true
ENABLE_GAMIFICATION=true
ENABLE_UPSELLS=true
ENABLE_CART_RECOVERY=true
ENABLE_DRIP_CONTENT=true

# A/B Testing
AB_TEST_LANDING_PAGE=variant_a
AB_TEST_CHECKOUT_FLOW=variant_b

# ============================================
# SECURITY
# ============================================

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ALLOWED_ORIGINS=https://paraguayimport.com.br,https://app.paraguayimport.com.br

# ============================================
# CRON JOBS (Optional - if not using external cron)
# ============================================

CRON_CART_RECOVERY=0 */15 * * * *  # Every 15 minutes
CRON_METRICS_CHECK=0 */5 * * * *   # Every 5 minutes
CRON_EMAIL_SEQUENCES=0 */30 * * * * # Every 30 minutes

# ============================================
# DEVELOPMENT ONLY
# ============================================

# Disable in production
DEBUG=false
LOG_LEVEL=info  # error | warn | info | debug
MOCK_PAYMENTS=false
SKIP_EMAIL_SEND=false
